"#version 300 es\n"
"// shader-version: 1.0.5\n"
"\n"
"precision mediump float;\n"
"\n"
"in vec3 vert;\n"
"out vec2 fragTexCoord;\n"
"\n"
"void main()\n"
"{\n"
"    // Map the vertex position from NDC (-1 to 1) to texture coordinates (0 t"
"o 1)\n"
"    fragTexCoord = (vert.xy * 0.5) + 0.5;\n"
"    gl_Position = vec4(vert, 1);\n"
"}\n"
